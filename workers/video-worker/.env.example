# Required — copy to .env and fill in
DATABASE_URL=postgres://...                # Supabase Postgres connection string (use the pooler URL)
SUPABASE_URL=https://azvdmibriuqrmexwtrja.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...              # Service role key — server-side only, never in the app bundle
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
PGSODIUM_KEY=...                           # For decrypting stored Drive tokens — see Supabase Vault

# Vision providers (frame/image tagging)
ANTHROPIC_API_KEY=...                      # Claude — curated image path (Sonnet) + Haiku fallback for video
GEMINI_API_KEY=...                         # Google Gemini — when set, video frames tag via gemini-2.5-flash (cheapest)

# Optional
LOG_LEVEL=info
WORKER_NAME=video-worker-1
PG_BOSS_SCHEMA=pgboss
# Vision tuning (env-overridable, sane defaults in code)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_INPUT_PER_M=0.30                     # approx USD / 1M input tokens — for the cost ledger
GEMINI_OUTPUT_PER_M=2.50                    # approx USD / 1M output tokens
VIDEO_MAX_SEGMENTS=6
VIDEO_SCENE_THRESHOLD=0.3
VIDEO_BLACK_THRESHOLD=0.05
VIDEO_DUP_DISTANCE=6
